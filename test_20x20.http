### Variables
@baseUrl = http://localhost:8080/api/v1/game

### 1. Initialize 20x20 Battlefield
# Player A: X[0-9], Player B: X[10-19]
POST {{baseUrl}}/init?n=20

###

### 2. Add Ship 1 (Small: Size 2, Offset 1)
# Player A Center (1,1) -> X[0,2], Y[0,2]
# Player B Center (11,1) -> X[10,12], Y[0,2]
POST {{baseUrl}}/ship
Content-Type: application/json

{
    "id": "SH1",
    "size": 2,
    "xA": 1, "yA": 1,
    "xB": 11, "yB": 1
}

###

### 3. Add Ship 2 (Medium: Size 4, Offset 2)
# Player A Center (5,7) -> X[3,7], Y[5,9]
# Player B Center (15,7) -> X[13,17], Y[5,9]
POST {{baseUrl}}/ship
Content-Type: application/json

{
    "id": "SH2",
    "size": 4,
    "xA": 5, "yA": 7,
    "xB": 15, "yB": 7
}

###

### 4. Add Ship 3 (Small: Size 2, Offset 1)
# Player A Center (8,15) -> X[7,9], Y[14,16]
# Player B Center (18,15) -> X[17,19], Y[14,16]
POST {{baseUrl}}/ship
Content-Type: application/json

{
    "id": "SH3",
    "size": 2,
    "xA": 8, "yA": 15,
    "xB": 18, "yB": 15
}

###

### 5. View Battlefield
# Verify placement in the 20x20 grid
GET {{baseUrl}}/view

###

### 6. Start the Battle
# Simulation runs until one player loses 3 ships
POST {{baseUrl}}/start